{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "paths": {
      "tallymark": ["./src/index.ts"],
      "tallymark/*": ["./src/*"]
    }
  },
  "include": ["src", "test", "scripts", "examples"],
  "exclude": ["scripts/smoke.ts", "examples/frameworks/deno.ts", "node_modules", "dist"]
}
